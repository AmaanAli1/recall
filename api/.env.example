# Copy to api/.env and fill in. api/.env is gitignored:
# never commit real values. Placeholders only here.

# Staging for local work: https://sikrkiebrudfqylhgdlu.supabase.co
SUPABASE_URL=https://<project-ref>.supabase.co
# The PUBLISHABLE key (sb_publishable_...), never the secret key.
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# From the OpenAI project "recall" (Phase 3+).
OPENAI_API_KEY=sk-xxx

# Any long random string; Next.js will send the same one.
# PowerShell: [guid]::NewGuid().ToString() + [guid]::NewGuid().ToString()
INTERNAL_KEY=change-me

# Optional; this is the default.
# OPENAI_ANSWER_MODEL=gpt-5.4-mini

# ---------- Laptop-only: the sample-ingest script ----------
# Supabase dashboard → Connect → Session pooler (port 5432),
# with your database password in place of [YOUR-PASSWORD].
# ADMIN rights: never put this in Vercel, AWS or GitHub.
# If the password has symbols like @ : / # %, URL-encode them.
ADMIN_DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-us-east-1.pooler.supabase.com:5432/postgres

# Copy to .env.local and fill in. Never commit .env.local.
# In Vercel: Project → Settings → Environment Variables.

# Postgres connection string (Supabase → Project Settings → Database → Connection string).
# Used by server-side code only, e.g. /api/health.
DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres

# Supabase project URL + anon (public) key (Project Settings → API).
NEXT_PUBLIC_SUPABASE_URL=https://[project-ref].supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# true = the UI uses the typed mock API in src/lib/api; flip per endpoint as the backend ships.
NEXT_PUBLIC_USE_MOCK_API=true

# true = demo sessions + the course list use the real API (route handlers + Supabase);
# documents, Ask, chats and Dyno stay mocked until their phase. Off in CI.
NEXT_PUBLIC_REAL_SESSIONS=false

# Cloudflare Turnstile site key (public by design). When set, and sessions are
# real, /demo runs a human check and new sessions need its token. The SECRET key
# goes only into the Supabase dashboard (Auth → Bot and Abuse Protection), never here.
# Leave empty locally: no check, and the route doesn't ask for a token.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# true = saved chats in Ask use the real API (needs REAL_SESSIONS=true too,
# and REAL_ASK=true: since 2026-11-27 answers are saved only by the server,
# in /api/ask). Off in CI.
NEXT_PUBLIC_REAL_CHATS=false

# true = Ask gets real, cited answers from /api/ask (RAG), saved into the chat
# by the server. Needs REAL_CHATS=true too, plus FASTAPI_URL and
# FASTAPI_INTERNAL_KEY below. Off here so e2e runs on the mock.
NEXT_PUBLIC_REAL_ASK=false

# true = "Try the demo" opens a "RAG in development, please stand by" dialog
# instead of starting a session. Vercel Production only, until RAG Phase 5c ships.
NEXT_PUBLIC_DEMO_STANDBY=false

# The answer service (FastAPI on AWS Lambda), for POST /api/ask.
# SERVER-ONLY (no NEXT_PUBLIC_): the internal key must never reach the browser.
# Vercel Preview -> the staging function, Production -> the production one.
FASTAPI_URL=https://your-function-url.lambda-url.us-east-1.on.aws/
FASTAPI_INTERNAL_KEY=your-internal-key
